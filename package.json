{
  "name": "dartsisas-spice-datasource",
  "version": "1.1.0",
  "description": "Data source plugin that gets data from spice",
  "scripts": {
    "build": "webpack -c webpack.config.ts --env production",
    "dev": "webpack -w -c webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "pnpm run lint --fix",
    "e2e": "playwright test",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "ISAS/JAXA",
  "license": "LGPL-3.0-only",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@grafana/eslint-config": "^7.0.0",
    "@grafana/plugin-e2e": "1.2.0",
    "@grafana/tsconfig": "1.2.0-rc1",
    "@playwright/test": "^1.57.0",
    "@swc/core": "^1.15.8",
    "@swc/helpers": "^0.5.18",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.21",
    "@types/node": "^20.19.27",
    "@types/react-router-dom": "^5.3.3",
    "@types/testing-library__jest-dom": "5.14.8",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-webpack-plugin": "^4.2.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.5.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2.8.8",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "10.3.3",
    "@grafana/runtime": "10.3.3",
    "@grafana/schema": "10.3.3",
    "@grafana/ui": "10.3.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rxjs": "7.8.2",
    "timecraftjs": "^2.0.0",
    "tslib": "2.5.3"
  },
  "overrides": {
    "rxjs": "7.8.2",
    "dompurify": "3.3.1",
    "prismjs": "1.30.0",
    "uplot": "1.6.32",
    "react-router": "6.30.3",
    "inflight": "npm:noop2@latest",
    "rimraf": "5.0.10",
    "core-js": "3.47.0",
    "whatwg-encoding": "npm:@exodus/bytes@latest",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@latest",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@latest"
  },
